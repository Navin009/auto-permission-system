{
  "enabled": true,
  "mode": "advanced-secure",
  "network": {
    "allowLocalhost": false,
    "strictAllowlist": true,
    "allowedDomains": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "npmjs.org",
      "*.npmjs.org",
      "pypi.org",
      "*.pypi.org",
      "files.pythonhosted.org",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "codeload.github.com",
      "crates.io",
      "proxy.golang.org",
      "repo.maven.apache.org",
      "rubygems.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "outsideProject": {
      "read": "deny"
    },
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.gnupg",
      "~/.pi/agent/auth.json"
    ],
    "denyWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      ".pypirc",
      ".npmrc"
    ]
  },
  "subagent": {
    "network": "deny"
  },
  "commands": {
    "ask": [
      "printenv",
      "env",
      "/proc/*/environ"
    ]
  }
}
