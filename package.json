{
  "name": "auto-permission-system",
  "version": "2.19.1",
  "description": "In-process tool guard and subagent posture hardening for Pi coding agent. Enforces filesystem allow/deny lists and domain allowlists on read, grep, find, ls, write, edit, fetch_content, web_search, and get_search_content — with interactive ask-tier prompts to grant access without leaving pi.",
  "type": "module",
  "author": "Navin Kumar",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "security",
    "sandbox",
    "guard",
    "policy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Navin009/auto-permission-system.git"
  },
  "bugs": {
    "url": "https://github.com/Navin009/auto-permission-system/issues"
  },
  "homepage": "https://github.com/Navin009/auto-permission-system#readme",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node security/tests/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.78"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/sandbox.ts",
      "./extensions/guard.ts",
      "./extensions/permission-mode.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/Navin009/auto-permission-system/main/banner.png"
  },
  "files": [
    "extensions/",
    "src/",
    "skills/",
    "sandbox.example.json",
    "sandbox.default.json",
    "banner.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true
  }
}
