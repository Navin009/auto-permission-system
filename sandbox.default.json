{
  "enabled": true,
  "mode": "advanced-secure",
  "network": {
    "allowedDomains": [
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "npmjs.org",
      "*.npmjs.org",
      "pypi.org",
      "*.pypi.org",
      "files.pythonhosted.org",
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "objects.githubusercontent.com",
      "codeload.github.com",
      "crates.io",
      "static.crates.io",
      "proxy.golang.org",
      "sum.golang.org",
      "repo.maven.apache.org",
      "rubygems.org",
      "api.nuget.org",
      "deno.land",
      "jsr.io"
    ]
  },
  "filesystem": {
    "outsideProject": {
      "read": "allow",
      "allowRead": []
    },
    "denyRead": [],
    "askRead": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "*.keystore",
      "*.ppk",
      "id_rsa",
      "id_rsa.*",
      "id_ed25519",
      "id_ed25519.*",
      "id_ecdsa",
      "id_ecdsa.*",
      ".netrc",
      ".npmrc",
      ".pypirc",
      ".gitconfig",
      ".git-credentials",
      "credentials",
      "*.credentials",
      "credentials.toml",
      "hosts.yml",
      "auth.json",
      "mcp.json",
      "mcp-auth.json",
      "models-store.json",
      "trust.json",
      "audit.log",
      "sessions"
    ],
    "modelDenyRead": [],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyWrite": [],
    "askWrite": [
      ".env",
      ".env.*",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "auth.json",
      "mcp.json",
      "mcp-auth.json",
      "~/.gnupg",
      "~/.ssh/**",
      "~/.pi/agent/extensions",
      "~/.pi/agent/extensions/**",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/mcp.json",
      "~/.pi/agent/mcp-auth.json",
      "~/.pi/agent/trust.json",
      "~/.pi/agent/models-store.json",
      "~/.pi/agent/audit.log",
      "~/.pi/agent/sessions",
      "~/.pi/sessions",
      "~/.bashrc",
      "~/.zshrc",
      "~/.profile",
      "~/.bash_profile"
    ]
  },
  "subagent": {
    "network": "allow"
  },
  "commands": {
    "ask": [
      "printenv",
      "env",
      "/proc/*/environ"
    ]
  },
  "overrides": {
    "allowRead": [],
    "allowWrite": [],
    "allowDomains": []
  }
}
