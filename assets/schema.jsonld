    {
      "@type": "FAQPage",
      "@id": "https://github.com/Navin009/auto-permission-system#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is auto-permission-system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Pi package (npm:auto-permission-system) that adds a zero-trust permission system and a Claude-style tool view to the Pi coding agent."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Pi permission system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A policy engine enforced in two layers plus a redactor: an OS sandbox around bash (bubblewrap on Linux, sandbox-exec on macOS), an in-process tool guard for read, grep, find, ls, write, edit, fetch_content, web_search and MCP tools, and a scan that hides credentials in tool output before the model reads it."
          }
        },
        {
          "@type": "Question",
          "name": "What is Claude auto mode for Pi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "An autonomous but fail-closed posture for unattended Pi runs: pi -p, CI jobs, containers and subagents keep working with no human at the keyboard, and anything unapproved is blocked with a reason instead of hanging. The shipped sandbox.claude.json preset enables it."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Pi tool view?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A display-only renderer: /tool-view compact draws each run of shell calls, reads and codemode as one Claude-style row with a mark, a count and a single timer, while /tool-view full (the default) leaves Pi's own output untouched. It never reads or writes the sandbox policy."
          }
        },
        {
          "@type": "Question",
          "name": "What is auto secure mode?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The advanced-secure permission mode: it keeps every policy rule and adds secret and credential detection, MCP risk scoring and real-time redaction, and can only add asks or blocks, never loosen one. Choose it with /permission-mode."
          }
        },
        {
          "@type": "Question",
          "name": "Does it work on Windows?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Layers 2 and 3 are platform independent, so the tool guard and the secret redactor run on Windows. Layer 1 (the OS sandbox for bash) requires bubblewrap and socat on Linux or the built-in sandbox-exec on macOS."
          }
        },
        {
          "@type": "Question",
          "name": "How much does auto-permission-system cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nothing. It is MIT licensed, runs locally, and adds no account, API key or telemetry."
          }
        }
      ]
    }
  ]
}
